<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Testy dymne w prawdziwym BricsCAD V25 (osobny DLL z [CommandMethod], NETLOAD po wtyczce).
    Wtyczka jest referencją projektu tylko dla kolejności budowania: testy sięgają do niej wyłącznie
    przez refleksję na zestawie wczytanym NETLOAD-em (Private=false — bez kopii BricsCadRc.dll obok testów,
    żeby nie wczytać drugiej kopii wtyczki).
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/BricsCadRc.csproj">
      <Private>false</Private>
    </ProjectReference>
    <Reference Include="BrxMgd">
      <HintPath>$(ProgramW6432)\Bricsys\BricsCAD V25 en_US\BrxMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TD_Mgd">
      <HintPath>$(ProgramW6432)\Bricsys\BricsCAD V25 en_US\TD_Mgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
