<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <!-- NA Smart RC: inna nazwa DLL niż stara wtyczka BricsCadRc, żeby obie mogły być zainstalowane obok siebie -->
    <AssemblyName>NaSmartRc</AssemblyName>
    <RootNamespace>BricsCadRc</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <!-- WPF support -->
    <UseWPF>true</UseWPF>
    <!-- Output directly to BricsCAD folder for easy testing -->
    <!-- Change this path if BricsCAD is installed elsewhere -->
    <OutputPath>..\bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- BricsCAD V25 SDK - Copy Local = false (DLL-e muszą zostac w folderze BricsCAD) -->
    <Reference Include="BrxMgd">
      <HintPath>$(ProgramW6432)\Bricsys\BricsCAD V25 en_US\BrxMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- System.IO.Compression: czytanie .xlsx (zip) bez zewnętrznych bibliotek -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="TD_Mgd">
      <HintPath>$(ProgramW6432)\Bricsys\BricsCAD V25 en_US\TD_Mgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- NPOI: zapis BBS w formacie .xls (szablon Speedeck), jak w AsdRcSlab. DLL-e NPOI trafiaja do bin obok BricsCadRc.dll -->
    <PackageReference Include="NPOI" Version="2.5.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wbudowany szablon BBS (RC_BBS) -->
    <EmbeddedResource Include="Resources\default-bbs.xls" LogicalName="BricsCadRc.default-bbs.xls" />
    <!-- Szablon arkusza RC (RC_PRZYGOTUJ_GA, decyzja 2026-10-14): tytuły rzutów, layout A1 bez rzutni, detale PH1–PH9 -->
    <EmbeddedResource Include="Resources\rc-template.dxf.gz" LogicalName="BricsCadRc.rc-template.dxf.gz" />
    <!-- Ikony wstazki (32 i 16 px) -->
    <EmbeddedResource Include="Resources\Icons\*.png" LogicalName="BricsCadRc.Icons.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plan C etap 2: testy dymne (tools/BrxSmokeTests) mogą używać typów internal -->
    <InternalsVisibleTo Include="BrxSmokeTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Referencje .NET 4.8 bez koniecznosci instalacji Visual Studio -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
